# =========================================================================
# Real-Estate Scraper — Configuration
# Copy to .env and fill in. .env is gitignored.
# =========================================================================

# ----- Notion -----
# 1. Create internal integration at https://www.notion.so/profile/integrations
# 2. Copy the "Internal Integration Secret" (starts with ntn_ or secret_) below
# 3. Open your parent page in Notion → "..." → Connections → add the integration
# 4. Run `python scripts/setup_notion.py` to create the rent DB
#    then paste the returned DB id into NOTION_RENT_DB_ID
NOTION_TOKEN=

# Parent page id (from the page URL you gave — dashes added)
NOTION_PARENT_PAGE_ID=

# Populated by scripts/setup_notion.py after first run
NOTION_RENT_DB_ID=

# ----- Module toggle -----
# Enabled modules this run: rent | buy | sell | rent_for_others (comma-separated)
MODULES_ENABLED=rent

# ----- Sources -----
SOURCE_ZAPIMOVEIS_ENABLED=true
SOURCE_QUINTOANDAR_ENABLED=true

# ----- Search: RENT module -----
RENT_CITY=São Paulo
RENT_STATE=SP
# Neighborhoods in preference order (comma-separated, exact casing matches source normalization)
RENT_NEIGHBORHOODS=Moema,Jardim Paulistano,Jardim Paulista,Vila Nova Conceição,Campo Belo,Brooklin,Itaim Bibi,Vila Olímpia,Pinheiros

# Total monthly price incl. condo + IPTU (BRL)
RENT_PRICE_MIN=4500
RENT_PRICE_MAX=6300

# Unit constraints
RENT_BEDROOMS_MIN=2
RENT_BEDROOMS_MAX=3
RENT_BATHROOMS_MIN=2
RENT_SUITES_MIN=1
RENT_SQM_MIN=70
RENT_PARKING_MIN=1
RENT_PETS_REQUIRED=true

# ----- Work location + distance cap -----
WORK_ADDRESS=Av. Pres. Juscelino Kubitschek, 1830 - Itaim Bibi, São Paulo - SP, 04543-900
WORK_MAX_DISTANCE_KM=5.5
# Optional override (skip geocoding if set)
WORK_LAT=
WORK_LNG=

# ----- Schedule -----
# Cron expressions (one per run time, comma-separated); default = 2×/day 09:00 + 18:00 BRT
SCHEDULE_CRON_TIMES=0 9 * * *,0 18 * * *
SCHEDULE_TZ=America/Sao_Paulo

# ----- HTTP + anti-bot -----
# Enrich is the long pole of a cycle: one detail fetch per listing, each of them
# sleeping MIN..MAX first. Cost is roughly listings x mean_delay / POOL_WORKERS,
# so these three move together — raising the pool or dropping the delays both
# raise the request rate seen at the source in the same proportion.
POOL_WORKERS=10
HTTP_IMPERSONATE=chrome124
HTTP_MIN_DELAY_SEC=3
HTTP_MAX_DELAY_SEC=10
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SEC=1
# Playwright fallback if HTTP gets 403 repeatedly
HTTP_PLAYWRIGHT_FALLBACK=true

# User-Agent rotation pool (| separated). Leave blank to use curl-cffi default.
HTTP_USER_AGENTS=

# ----- Notion write pacing -----
# Notion averages ~3 req/s per integration; writes are paced centrally.
NOTION_MAX_RPS=2.5
# Snapshot the base once per cycle as (Source, ExternalID) -> page instead of
# spending one lookup query per listing behind that pacer. Set false to go back
# to querying per listing.
NOTION_PAGE_INDEX=true
NOTION_INDEX_PAGE_SIZE=100

# ----- Geocoding -----
GEOCODER_USER_AGENT=real-estate-scraper/0.1 
GEOCODER_RATE_LIMIT_SEC=1

# ----- Logging -----
LOG_LEVEL=INFO
LOG_DIR=logs

# ----- Cache -----
CACHE_DIR=.cache

# ----- Search: BUY module -----
# All filters configurable independently from RENT_*.
# BUY_NEIGHBORHOODS falls back to RENT_NEIGHBORHOODS if blank.
BUY_CITY=São Paulo
BUY_STATE=SP
BUY_NEIGHBORHOODS=
BUY_PRICE_MIN=500000
BUY_PRICE_MAX=1200000
# Max monthly condominium fee in BRL (0 = no cap; applied post-fetch)
BUY_CONDO_MAX=0
BUY_BEDROOMS_MIN=2
BUY_BEDROOMS_MAX=3
BUY_BATHROOMS_MIN=2
BUY_SUITES_MIN=1
BUY_SQM_MIN=70
BUY_PARKING_MIN=1
# Property types: apartment,house,condo_house (or blank for any)
BUY_PROPERTY_TYPES=
BUY_PETS_REQUIRED=false
BUY_FURNISHED_ALLOWED=true
# Drop a listing on what the search hit already says, before paying a detail
# fetch for it. Cannot cover distance, suites or the condo fee - the search
# payload carries none of those on the basis the filters need.
BUY_PREFILTER_ENABLED=true

# ----- Notion: BUY module -----
# Populated by: uv run python scripts/setup_notion.py --kind buy
NOTION_BUY_DB_ID=

# ----- Sources: BUY module -----
SOURCE_ZAPIMOVEIS_BUY_ENABLED=true
SOURCE_QUINTOANDAR_BUY_ENABLED=false

# ----- Condo enrichment (name + build year + age) -----
# QuintoAndar serves condominium.name on ~100% of listings and constructionYear
# on ~10%. The rest of the years are resolved once per building and cached
# forever in .cache/condos.json.
CONDO_ENRICH_ENABLED=true
CONDO_APARTMENT_TYPES=Apartamento,APARTMENT
CONDO_SEARCH_ENABLED=true
# claude | serper | brave | google_cse.
#   claude     -> runs `claude -p` with WebSearch/WebFetch and reads the ficha
#                 tecnica itself. No API key: it uses the Claude Code login on
#                 this machine. For unattended runs set a long-lived token with
#                 `claude setup-token` and export CLAUDE_CODE_OAUTH_TOKEN, or
#                 set ANTHROPIC_API_KEY — an interactive OAuth session expires
#                 and the scheduled run then silently resolves nothing.
#   serper/brave/google_cse -> the old SERP-snippet tier. It reads years out of
#                 search snippets and cannot tell a ficha tecnica from a
#                 neighbourhood index page: that is how a 1977 building was
#                 recorded as 2023 and ranked first in the whole base.
CONDO_SEARCH_PROVIDER=claude
CONDO_SEARCH_API_KEY=
CONDO_SEARCH_CSE_ID=
# Buildings resolved per run. The claude tier costs roughly $0.05-0.15 each, so
# the first backfill of ~250 unresolved buildings is the only expensive run.
CONDO_SEARCH_MAX_PER_RUN=50
# Lowest confidence that may write BuiltYear: estimated | medium | high.
# Anything below the floor is still recorded in CondoConfidence, just not used.
CONDO_SEARCH_MIN_CONFIDENCE=medium

# --- claude tier ---
CONDO_AGENT_CMD=claude
CONDO_AGENT_MODEL=sonnet
CONDO_AGENT_TIMEOUT_SEC=420
# Hard per-building spend cap handed to `claude --max-budget-usd`.
CONDO_AGENT_MAX_USD=1.20
CONDO_AGENT_CONCURRENCY=2
# Agent lookups get their own pool so a multi-minute one cannot sit on a worker
# the detail fetches are queued behind. 0 = mirror CONDO_AGENT_CONCURRENCY.
CONDO_POOL_WORKERS=0
# A building the search already failed on is parked for good — its year is not
# in any snippet, so retrying costs a credit every run for nothing. Turn this on
# only after changing the extractor, or run `condo-retry-misses` once.
CONDO_SEARCH_RETRY_MISSES=false
CONDO_SEARCH_RETRY_DAYS=90
